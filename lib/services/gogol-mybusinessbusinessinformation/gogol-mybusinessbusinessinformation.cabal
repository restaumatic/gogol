cabal-version:         2.2
name:                  gogol-mybusinessbusinessinformation
version:               1.0.0
synopsis:              Google My Business Business Information SDK.
homepage:              https://github.com/brendanhay/gogol
bug-reports:           https://github.com/brendanhay/gogol/issues
license:               MPL-2.0
license-file:          LICENSE
author:                Brendan Hay
maintainer:            Brendan Hay <brendan.g.hay+gogol@gmail.com>, Toni Cebrián <toni@tonicebrian.com>
copyright:             Copyright (c) 2015-2025 Brendan Hay
category:              Google
build-type:            Simple
extra-source-files:    README.md src/.gitkeep
description:
    The My Business Business Information API provides an interface for managing business information. Note - If you have a quota of 0 after enabling the API, please request for GBP API access.
  .
  /Warning:/ This is an experimental prototype/preview release which is still
  under exploratory development and not intended for public use, caveat emptor!
  .
  This library is compatible with version @v1@
  of the API.

source-repository head
  type:     git
  location: git://github.com/brendanhay/gogol.git
  subdir:   gogol-mybusinessbusinessinformation

flag field-selectors
  description: If record field selectors should be enabled. Disabling this requires GHC >=9.2 and the NoFieldSelectors extension.
  default: False
  manual: True

library
  default-language:  GHC2021
  hs-source-dirs:    src gen

  ghc-options:
    -Wall
    -fwarn-incomplete-uni-patterns
    -fwarn-incomplete-record-updates
    -funbox-strict-fields
    -fwarn-unused-packages

  if !flag(field-selectors) && impl(ghc >= 9.2)
    default-extensions: NoFieldSelectors

  exposed-modules:
      Gogol.MyBusinessBusinessInformation
    , Gogol.MyBusinessBusinessInformation.Accounts.Locations.Create
    , Gogol.MyBusinessBusinessInformation.Accounts.Locations.List
    , Gogol.MyBusinessBusinessInformation.Attributes.List
    , Gogol.MyBusinessBusinessInformation.Categories.BatchGet
    , Gogol.MyBusinessBusinessInformation.Categories.List
    , Gogol.MyBusinessBusinessInformation.Chains.Get
    , Gogol.MyBusinessBusinessInformation.Chains.Search
    , Gogol.MyBusinessBusinessInformation.GoogleLocations.Search
    , Gogol.MyBusinessBusinessInformation.Locations.Attributes.GetGoogleUpdated
    , Gogol.MyBusinessBusinessInformation.Locations.Delete
    , Gogol.MyBusinessBusinessInformation.Locations.Get
    , Gogol.MyBusinessBusinessInformation.Locations.GetAttributes
    , Gogol.MyBusinessBusinessInformation.Locations.GetGoogleUpdated
    , Gogol.MyBusinessBusinessInformation.Locations.Patch
    , Gogol.MyBusinessBusinessInformation.Locations.UpdateAttributes
    , Gogol.MyBusinessBusinessInformation.Types

  other-modules:
      Gogol.MyBusinessBusinessInformation.Internal.Product
    , Gogol.MyBusinessBusinessInformation.Internal.Sum

  build-depends:
      gogol-core ^>= 1.0.0
