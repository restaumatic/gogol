cabal-version:         2.2
name:                  gogol-mybusinessaccountmanagement
version:               1.0.0
synopsis:              Google My Business Account Management SDK.
homepage:              https://github.com/brendanhay/gogol
bug-reports:           https://github.com/brendanhay/gogol/issues
license:               MPL-2.0
license-file:          LICENSE
author:                Brendan Hay
maintainer:            Brendan Hay <brendan.g.hay+gogol@gmail.com>, Toni Cebrián <toni@tonicebrian.com>
copyright:             Copyright (c) 2015-2025 Brendan Hay
category:              Google
build-type:            Simple
extra-source-files:    README.md src/.gitkeep
description:
    The My Business Account Management API provides an interface for managing access to a location on Google. Note - If you have a quota of 0 after enabling the API, please request for GBP API access.
  .
  /Warning:/ This is an experimental prototype/preview release which is still
  under exploratory development and not intended for public use, caveat emptor!
  .
  This library is compatible with version @v1@
  of the API.

source-repository head
  type:     git
  location: git://github.com/brendanhay/gogol.git
  subdir:   gogol-mybusinessaccountmanagement

flag field-selectors
  description: If record field selectors should be enabled. Disabling this requires GHC >=9.2 and the NoFieldSelectors extension.
  default: False
  manual: True

library
  default-language:  GHC2021
  hs-source-dirs:    src gen

  ghc-options:
    -Wall
    -fwarn-incomplete-uni-patterns
    -fwarn-incomplete-record-updates
    -funbox-strict-fields
    -fwarn-unused-packages

  if !flag(field-selectors) && impl(ghc >= 9.2)
    default-extensions: NoFieldSelectors

  exposed-modules:
      Gogol.MyBusinessAccountManagement
    , Gogol.MyBusinessAccountManagement.Accounts.Admins.Create
    , Gogol.MyBusinessAccountManagement.Accounts.Admins.Delete
    , Gogol.MyBusinessAccountManagement.Accounts.Admins.List
    , Gogol.MyBusinessAccountManagement.Accounts.Admins.Patch
    , Gogol.MyBusinessAccountManagement.Accounts.Create
    , Gogol.MyBusinessAccountManagement.Accounts.Get
    , Gogol.MyBusinessAccountManagement.Accounts.Invitations.Accept
    , Gogol.MyBusinessAccountManagement.Accounts.Invitations.Decline
    , Gogol.MyBusinessAccountManagement.Accounts.Invitations.List
    , Gogol.MyBusinessAccountManagement.Accounts.List
    , Gogol.MyBusinessAccountManagement.Accounts.Patch
    , Gogol.MyBusinessAccountManagement.Locations.Admins.Create
    , Gogol.MyBusinessAccountManagement.Locations.Admins.Delete
    , Gogol.MyBusinessAccountManagement.Locations.Admins.List
    , Gogol.MyBusinessAccountManagement.Locations.Admins.Patch
    , Gogol.MyBusinessAccountManagement.Locations.Transfer
    , Gogol.MyBusinessAccountManagement.Types

  other-modules:
      Gogol.MyBusinessAccountManagement.Internal.Product
    , Gogol.MyBusinessAccountManagement.Internal.Sum

  build-depends:
      gogol-core ^>= 1.0.0
